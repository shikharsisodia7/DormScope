# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dormscope?schema=public"

# Next.js Web
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_MAPBOX_TOKEN=""

# API Server
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Clerk Auth (optional — app works without it)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Redis + BullMQ (background jobs)
REDIS_URL="redis://localhost:6379"

# OpenAI (optional — rule-based summaries work without it)
OPENAI_API_KEY=""

# Scraper
SCRAPER_USER_AGENT="DormScopeBot/1.0 (+https://dormscope.com/bot)"
SCRAPER_RATE_LIMIT_MS=2000
STORAGE_PATH="./uploads"

# Supabase Storage (optional)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="dorm-images"
