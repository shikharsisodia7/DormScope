# Database (Neon / Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dormscope?sslmode=require"

# Next.js Web
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Leave empty to use same-origin /api (recommended for Vercel)
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_MAPBOX_TOKEN=""

# API Server (optional local Express)
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Admin mutating routes (service-to-service; never expose to browser)
ADMIN_API_KEY=""
# Clerk allowlist for admin UI (comma-separated)
ADMIN_USER_IDS=""
ADMIN_EMAILS=""

# Clerk Auth (optional — guest favorites work via localStorage)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Redis + BullMQ (optional background jobs)
REDIS_URL="redis://localhost:6379"

# OpenAI (optional — rule-based summaries work without it)
OPENAI_API_KEY=""

# College Scorecard (optional — DEMO_KEY used by default)
COLLEGE_SCORECARD_API_KEY=""

# Scraper
SCRAPER_USER_AGENT="DormScopeBot/1.0 (+https://dormscope.com/bot)"
SCRAPER_RATE_LIMIT_MS=2000
STORAGE_PATH="./uploads"

# Supabase Storage (optional)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="dorm-images"
