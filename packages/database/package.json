{
  "name": "@dormscope/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./integration": "./src/integration/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "push": "prisma db push",
    "migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "build": "prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "import:institutions": "tsx scripts/import-institutions.ts",
    "seed:halls": "tsx scripts/seed-official-hall-directories.ts",
    "coverage": "tsx scripts/coverage-report.ts",
    "backfill:eligibility": "tsx scripts/backfill-unknown-eligibility.ts",
    "audit:housing": "tsx scripts/audit-housing.ts",
    "quarantine:junk": "tsx scripts/cleanup-junk-housing.ts",
    "recompute:coverage": "tsx scripts/recompute-coverage.ts",
    "recompute:scores": "tsx scripts/recompute-scores.ts",
    "reconcile:sources": "tsx scripts/reconcile-sources.ts",
    "find:duplicates": "tsx scripts/find-duplicates.ts",
    "hierarchy:audit": "tsx scripts/hierarchy-audit.ts"
  },
  "dependencies": {
    "@dormscope/scoring": "*",
    "@dormscope/shared": "*",
    "@prisma/client": "^5.22.0"
  },
  "optionalDependencies": {
    "adm-zip": "^0.5.18"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
