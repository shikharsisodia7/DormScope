{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "scripts/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["scripts/import-institutions-fast.ts", "scripts/smoke-rank.ts"]
}
