generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SchoolType {
  PUBLIC
  PRIVATE
}

enum Region {
  NORTHEAST
  SOUTHEAST
  MIDWEST
  SOUTHWEST
  WEST
  NORTHWEST
  OTHER
}

enum DormType {
  RESIDENCE_HALL
  SUITE
  APARTMENT
  TOWNHOUSE
  THEME_HOUSE
  HONORS
  FRESHMAN_ONLY
  MIXED
  UNKNOWN
}

enum BathroomStyle {
  COMMUNAL
  SUITE
  PRIVATE
  SEMI_PRIVATE
  UNKNOWN
}

enum SourceType {
  OFFICIAL_WEBSITE
  OFFICIAL_PDF
  HOUSING_RATES
  CAMPUS_MAP
  RESIDENCE_LIFE
  PUBLIC_REVIEW
  STUDENT_FORUM
  OTHER
}

enum ScrapeJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum UserRole {
  USER
  ADMIN
}

enum HousingCoverageStatus {
  UNKNOWN
  NO_HOUSING
  DISCOVERY_PENDING
  SITE_FOUND
  DIRECTORY_PENDING
  PARTIAL
  COMPLETE
  BLOCKED
  FAILED
  RETRYABLE
}

/// Structural role of a housing record in the university's inventory.
enum HousingEntityKind {
  COMPLEX
  RESIDENTIAL_COLLEGE
  VILLAGE
  UNIT
  BUILDING
  HOUSE
  APARTMENT_COMMUNITY
  SUITE_COMMUNITY
  LIVING_COMMUNITY
  RESIDENCE
  OTHER
  UNKNOWN
}

/// Publication / review state for scraped housing entities.
enum DataQualityStatus {
  ACTIVE
  REVIEW
  QUARANTINED
  DUPLICATE
  RETIRED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── College (Institution) ───────────────────────────────────────────────────

model College {
  id                     String                 @id @default(cuid())
  name                   String
  slug                   String                 @unique
  city                   String
  state                  String
  region                 Region                 @default(OTHER)
  schoolType             SchoolType             @default(PUBLIC)
  websiteUrl             String?
  housingUrl             String?
  acceptanceRate         Float?
  studentPopulation      Int?
  latitude               Float?
  longitude              Float?
  lastUpdatedAt          DateTime               @default(now())
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  // National institution identifiers & coverage
  ipedsUnitId            String?                @unique
  opeid                  String?
  countryCode            String                 @default("US")
  institutionType        String?
  hasResidentialHousing  Boolean?
  housingCoverageStatus  HousingCoverageStatus  @default(UNKNOWN)
  officialName           String?
  shortName              String?
  dataFreshnessAt        DateTime?
  lastCrawlAttemptAt     DateTime?
  lastDiscoverySuccessAt DateTime?
  lastInventorySuccessAt DateTime?

  dorms                  Dorm[]
  campuses               Campus[]
  aliases                CollegeAlias[]
  sources                Source[]
  scrapeJobs             ScrapeJob[]
  dataQualityReports     DataQualityReport[]
  fieldProvenance        FieldProvenance[]
  preferenceProfiles     PreferenceProfile[]
  matchRuns              MatchRun[]
  savedByUsers           SavedCollege[]
  institutionImports     InstitutionImport[]
  ingestCheckpoint       IngestCheckpoint?
  extractionDecisions    ExtractionDecision[]

  @@index([state])
  @@index([name])
  @@index([ipedsUnitId])
  @@index([housingCoverageStatus])
  @@index([countryCode, state])
}

model CollegeAlias {
  id        String   @id @default(cuid())
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  alias     String
  createdAt DateTime @default(now())

  @@unique([collegeId, alias])
  @@index([alias])
  @@index([collegeId])
}

// ─── Campus ──────────────────────────────────────────────────────────────────

model Campus {
  id         String   @id @default(cuid())
  collegeId  String
  college    College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  city       String?
  state      String?
  latitude   Float?
  longitude  Float?
  isPrimary  Boolean  @default(false)
  websiteUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  dorms      Dorm[]

  @@unique([collegeId, slug])
  @@index([collegeId])
  @@index([name])
}

// ─── Dorm ────────────────────────────────────────────────────────────────────

model Dorm {
  id                      String         @id @default(cuid())
  name                    String
  slug                    String
  collegeId               String
  college                 College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  dormType                DormType       @default(UNKNOWN)
  /// Tri-state housing facts: null = unknown / not collected (never treat as true/false).
  freshmanEligible        Boolean?
  upperclassEligible      Boolean?
  honorsHousing           Boolean?
  themedHousing           Boolean?
  genderInclusive         Boolean?
  bathroomStyle           BathroomStyle  @default(UNKNOWN)
  /// Hierarchy + ranking granularity (backward-compatible additions).
  entityKind              HousingEntityKind @default(UNKNOWN)
  officialCategoryLabel   String?
  parentHousingId         String?
  parentHousing           Dorm?          @relation("HousingHierarchy", fields: [parentHousingId], references: [id], onDelete: SetNull)
  childHousing            Dorm[]         @relation("HousingHierarchy")
  isAssignableHousingOption Boolean      @default(true)
  isPhysicalBuilding      Boolean        @default(true)
  rankingGranularity      Boolean        @default(true) // true = include in Match rankings when assignable
  hasAC                   Boolean?
  hasHeating              Boolean?
  laundryAccess           Boolean?
  kitchenAccess           Boolean?
  elevatorAccess          Boolean?
  studyLounges            Boolean?
  socialVibe              Float?
  quietVibe               Float?
  cleanlinessRating       Float?
  privacyRating           Float?
  safetyNotes             String?
  diningDistanceMeters    Int?
  gymDistanceMeters       Int?
  classroomDistanceMeters Int?
  campusZone              String?
  buildingAge             Int?
  renovationYear          Int?
  officialHousingUrl      String?
  imageUrl                String?
  virtualTourUrl          String?
  floorPlanUrl            String?
  yearlyCost              Float?
  semesterCost            Float?
  confidenceScore         Float          @default(0.5)
  dataCompletenessScore   Float          @default(0)
  latitude                Float?
  longitude               Float?
  lastUpdatedAt           DateTime       @default(now())
  verifiedAt              DateTime?
  isVerified              Boolean        @default(false)
  duplicateOfId           String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  // Campus link & aliases
  campusId                String?
  campus                  Campus?        @relation(fields: [campusId], references: [id], onDelete: SetNull)
  aliases                 DormAlias[]

  // Eligibility / configuration (null = unknown)
  graduateEligible        Boolean?
  genderConfiguration     String?
  hallStyleNotes          String?
  wheelchairAccessible    Boolean?
  accessibilityFeatures   Json?
  substanceFree           Boolean?
  quietHousing            Boolean?
  livingLearning          Boolean?
  constructedYear         Int?
  floors                  Int?
  approximateResidents    Int?
  description             String?
  isActive                Boolean        @default(true)
  dataQualityStatus       DataQualityStatus @default(ACTIVE)
  quarantineReason        String?
  quarantinedAt           DateTime?
  quarantinedBy           String?
  effectiveFrom           DateTime?
  effectiveTo             DateTime?
  mealPlanRequired        Boolean?
  address                 String?

  roomTypes               RoomType[]
  dormAmenities           DormAmenity[]
  housingCosts            HousingCost[]
  sources                 Source[]
  dormSources             DormSource[]
  reviewSummaries         ReviewSummary[]
  reviews                 Review[]
  dormScore               DormScore?
  favorites               FavoriteDorm[]
  comparisonItems         ComparisonItem[]
  fieldProvenance         FieldProvenance[]
  dataCorrections         DataCorrection[]
  fieldConflicts         FieldConflict[]
  matchResults            MatchResult[]
  extractionDecisions     ExtractionDecision[]

  @@unique([collegeId, slug])
  @@index([collegeId])
  @@index([name])
  @@index([collegeId, name])
  @@index([campusId])
  @@index([isActive])
  @@index([isVerified])
  @@index([parentHousingId])
  @@index([isAssignableHousingOption])
  @@index([entityKind])
  @@index([dataQualityStatus])
}

model DormAlias {
  id        String   @id @default(cuid())
  dormId    String
  dorm      Dorm     @relation(fields: [dormId], references: [id], onDelete: Cascade)
  alias     String
  createdAt DateTime @default(now())

  @@unique([dormId, alias])
  @@index([alias])
  @@index([dormId])
}

// ─── Room / Amenity / Cost ───────────────────────────────────────────────────

model RoomType {
  id           String  @id @default(cuid())
  dormId       String
  dorm         Dorm    @relation(fields: [dormId], references: [id], onDelete: Cascade)
  name         String
  normalized   String
  capacity     Int?
  description  String?
  yearlyCost   Float?
  semesterCost Float?
  confidence   Float   @default(0.5)

  @@index([dormId])
}

model Amenity {
  id          String   @id @default(cuid())
  name        String   @unique
  normalized  String   @unique
  category    String?
  icon        String?

  dormAmenities DormAmenity[]
}

model DormAmenity {
  id         String  @id @default(cuid())
  dormId     String
  dorm       Dorm    @relation(fields: [dormId], references: [id], onDelete: Cascade)
  amenityId  String
  amenity    Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  confidence Float   @default(0.5)
  sourceNote String?

  @@unique([dormId, amenityId])
}

model HousingCost {
  id           String   @id @default(cuid())
  dormId       String
  dorm         Dorm     @relation(fields: [dormId], references: [id], onDelete: Cascade)
  label        String
  amount       Float
  period       String
  academicYear String?
  confidence   Float    @default(0.5)
  isUncertain  Boolean  @default(false)
  sourceUrl    String?
  createdAt    DateTime @default(now())

  @@index([dormId])
}

// ─── Sources & Provenance ────────────────────────────────────────────────────

model Source {
  id            String     @id @default(cuid())
  url           String
  /// Normalized URL used for deduplication (scheme/host/path, stripped fragments/tracking).
  canonicalUrl  String?
  title         String?
  sourceType    SourceType @default(OTHER)
  confidence    Float      @default(0.5)
  scrapedAt     DateTime?
  collegeId     String?
  college       College?   @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  /// Legacy single-dorm link kept for compatibility; prefer DormSource for directories.
  dormId        String?
  dorm          Dorm?      @relation(fields: [dormId], references: [id], onDelete: SetNull)
  isApproved    Boolean    @default(false)
  rawSnippet    String?
  contentHash   String?
  httpStatus    Int?
  finalUrl      String?
  extractorVersion String?
  pageRole      String?
  createdAt     DateTime   @default(now())

  fieldProvenance FieldProvenance[]
  dormSources     DormSource[]
  extractionDecisions ExtractionDecision[]

  @@index([collegeId])
  @@index([dormId])
  @@index([canonicalUrl])
  @@unique([collegeId, canonicalUrl])
}

/// Many-to-many: one directory page can support many housing entities.
model DormSource {
  id        String   @id @default(cuid())
  dormId    String
  dorm      Dorm     @relation(fields: [dormId], references: [id], onDelete: Cascade)
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  role      String?  // directory | detail | rates | eligibility
  createdAt DateTime @default(now())

  @@unique([dormId, sourceId])
  @@index([sourceId])
  @@index([dormId])
}

/// Accepted/rejected housing candidates for diagnostics (not published inventory).
model ExtractionDecision {
  id          String   @id @default(cuid())
  collegeId   String
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  sourceId    String?
  source      Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  dormId      String?
  dorm        Dorm?    @relation(fields: [dormId], references: [id], onDelete: SetNull)
  candidateName String
  accepted    Boolean
  confidence  Float    @default(0)
  reasons     Json
  pageUrl     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([collegeId, accepted])
  @@index([sourceId])
  @@index([dormId])
}

/// Resumable national ingestion checkpoints per institution.
model IngestCheckpoint {
  id              String   @id @default(cuid())
  collegeId       String   @unique
  college         College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  stage           String   @default("queued") // queued|classify|discover|directory|extract|enrich|validate|complete
  status          String   @default("pending") // pending|running|blocked|retryable|failed|complete|no_housing
  pagesVisited    Int      @default(0)
  candidateUrls   String[] @default([])
  failureClass    String?
  lastHttpStatus  Int?
  retryCount      Int      @default(0)
  nextRetryAt     DateTime?
  lastError       String?
  lastSuccessAt   DateTime?
  lockedAt        DateTime?
  lockOwner       String?
  lastProcessedUrl String?
  heartbeatAt     DateTime?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, nextRetryAt])
  @@index([stage])
  @@index([lockOwner])
}

model FieldProvenance {
  id            String   @id @default(cuid())
  dormId        String?
  dorm          Dorm?    @relation(fields: [dormId], references: [id], onDelete: Cascade)
  collegeId     String?
  college       College? @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  fieldName     String
  valueSnapshot String?
  sourceId      String?
  source        Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceUrl     String?
  retrievalAt   DateTime @default(now())
  confidence    Float    @default(0.5)
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([dormId])
  @@index([collegeId])
  @@index([fieldName])
  @@index([dormId, fieldName])
  @@index([sourceId])
}

// ─── Reviews (student-submitted) ─────────────────────────────────────────────

model Review {
  id                   String       @id @default(cuid())
  dormId               String
  dorm                 Dorm         @relation(fields: [dormId], references: [id], onDelete: Cascade)
  userId               String?
  user                 User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId            String?
  overallRating        Float
  categoryRatings      Json?
  schoolYear           String?
  classYearLived       String?
  roomTypeLived        String?
  pros                 String?
  cons                 String?
  advice               String?
  body                 String?
  status               ReviewStatus @default(PENDING)
  affiliationVerified  Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  moderatedAt          DateTime?
  ipHash               String?

  reports              ReviewReport[]

  @@index([dormId])
  @@index([dormId, status])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ReviewReport {
  id        String           @id @default(cuid())
  reviewId  String
  review    Review           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reason    String
  details   String?
  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@index([reviewId])
  @@index([status])
}

/// Aggregated / generated review summaries (compat — not fabricated seed data).
model ReviewSummary {
  id               String   @id @default(cuid())
  dormId           String
  dorm             Dorm     @relation(fields: [dormId], references: [id], onDelete: Cascade)
  sentiment        String?
  vibeLabels       String[]
  pros             String[]
  cons             String[]
  ruleBasedSummary String?
  aiSummary        String?
  confidence       Float    @default(0.3)
  sourceCount      Int      @default(0)
  lastUpdatedAt    DateTime @default(now())

  @@index([dormId])
}

// ─── Data Corrections ────────────────────────────────────────────────────────

enum FieldConflictStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Conflicting field values from multiple sources awaiting resolution.
model FieldConflict {
  id        String              @id @default(cuid())
  dormId    String
  dorm      Dorm                @relation(fields: [dormId], references: [id], onDelete: Cascade)
  fieldName String
  status    FieldConflictStatus @default(OPEN)
  values    Json
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([dormId])
  @@index([dormId, fieldName])
  @@index([status])
}

model DataCorrection {
  id            String           @id @default(cuid())
  dormId        String
  dorm          Dorm             @relation(fields: [dormId], references: [id], onDelete: Cascade)
  fieldName     String
  proposedValue String
  sourceUrl     String?
  status        ModerationStatus @default(PENDING)
  submitterNote String?
  userId        String?
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())

  @@index([dormId])
  @@index([status])
  @@index([userId])
}

// ─── Scores ──────────────────────────────────────────────────────────────────

model DormScore {
  id                  String   @id @default(cuid())
  dormId              String   @unique
  dorm                Dorm     @relation(fields: [dormId], references: [id], onDelete: Cascade)
  /// Null when insufficient quality evidence to display an overall score.
  overallScore        Float?
  valueScore          Float?
  comfortScore        Float?
  privacyScore        Float?
  socialScore         Float?
  convenienceScore    Float?
  freshmanFitScore    Float?
  amenityScore        Float?
  dataConfidenceScore Float?
  evidenceCompleteness Float?
  scoreable           Boolean  @default(false)
  algorithmVersion    String?
  breakdown           Json?
  calculatedAt        DateTime @default(now())
}

// ─── Ingestion / Scraping ────────────────────────────────────────────────────

model ScrapeJob {
  id            String          @id @default(cuid())
  collegeId     String
  college       College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  status        ScrapeJobStatus @default(PENDING)
  startedAt     DateTime?
  completedAt   DateTime?
  errorMessage  String?
  candidateUrls String[]
  dormsFound    Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // IngestionJob extensions
  stage         String?
  retryCount    Int             @default(0)
  lastError     String?
  contentHash   String?
  resumedFromId String?
  resumedFrom   ScrapeJob?      @relation("ScrapeJobResume", fields: [resumedFromId], references: [id], onDelete: SetNull)
  resumes       ScrapeJob[]     @relation("ScrapeJobResume")

  logs          ScrapeLog[]

  @@index([collegeId])
  @@index([status])
  @@index([contentHash])
}

model ScrapeLog {
  id        String    @id @default(cuid())
  jobId     String
  job       ScrapeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     String
  message   String
  url       String?
  metadata  Json?
  createdAt DateTime  @default(now())

  @@index([jobId])
}

/// High-level institution import tracking (IPEDS / bulk loads).
model InstitutionImport {
  id           String          @id @default(cuid())
  collegeId    String?
  college      College?        @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  sourceLabel  String
  status       ScrapeJobStatus @default(PENDING)
  stage        String?
  retryCount   Int             @default(0)
  lastError    String?
  contentHash  String?
  recordCount  Int             @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([collegeId])
  @@index([status])
  @@index([contentHash])
}

// ─── Users & Favorites ───────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  clerkId       String?  @unique
  email         String   @unique
  name          String?
  role          UserRole @default(USER)
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  favorites             FavoriteDorm[]
  comparisonLists       ComparisonList[]
  recommendationProfile RecommendationProfile?
  preferenceProfiles    PreferenceProfile[]
  savedColleges         SavedCollege[]
  reviews               Review[]
  dataCorrections       DataCorrection[]
}

model SavedCollege {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  notes     String?
  createdAt DateTime @default(now())

  @@unique([userId, collegeId])
  @@index([userId])
  @@index([collegeId])
}

model FavoriteDorm {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dormId    String
  dorm      Dorm     @relation(fields: [dormId], references: [id], onDelete: Cascade)
  notes     String?
  createdAt DateTime @default(now())

  @@unique([userId, dormId])
}

model ComparisonList {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("My Comparison")
  sessionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     ComparisonItem[]
}

model ComparisonItem {
  id        String         @id @default(cuid())
  listId    String
  list      ComparisonList @relation(fields: [listId], references: [id], onDelete: Cascade)
  dormId    String
  dorm      Dorm           @relation(fields: [dormId], references: [id], onDelete: Cascade)
  sortOrder Int            @default(0)

  @@unique([listId, dormId])
}

// ─── Preferences & Matching ──────────────────────────────────────────────────

/// Legacy single-profile quiz answers (kept for backward compatibility).
model RecommendationProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isFreshman         Boolean?
  prefersSocial      Boolean?
  prefersQuiet       Boolean?
  priorityPrice      Float?
  priorityComfort    Float?
  priorityPrivacy    Float?
  priorityLocation   Float?
  wantsAC            Boolean?
  bathroomPreference String?
  nearDining         Boolean?
  apartmentStyle     Boolean?
  honorsThemed       Boolean?
  studyLounges       Boolean?
  cheapestVsBestFit  String?
  quizAnswers        Json?
  updatedAt          DateTime @updatedAt
}

/// Multi-profile preference store for personalized ranking.
model PreferenceProfile {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId        String?
  name             String   @default("Default")
  collegeId        String?
  college          College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  weights          Json
  hardConstraints  Json
  quickAnswers     Json?
  algorithmVersion String   @default("1")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  matchRuns        MatchRun[]

  @@index([userId])
  @@index([sessionId])
  @@index([collegeId])
}

model MatchRun {
  id               String             @id @default(cuid())
  profileId        String?
  profile          PreferenceProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  collegeId        String
  college          College            @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  weights          Json
  hardConstraints  Json
  algorithmVersion String             @default("1")
  usefulFeedback   Boolean?
  createdAt        DateTime           @default(now())
  shareToken       String?            @unique

  results          MatchResult[]

  @@index([profileId])
  @@index([collegeId])
  @@index([createdAt])
}

model MatchResult {
  id               String   @id @default(cuid())
  matchRunId       String
  matchRun         MatchRun @relation(fields: [matchRunId], references: [id], onDelete: Cascade)
  dormId           String
  dorm             Dorm     @relation(fields: [dormId], references: [id], onDelete: Cascade)
  rank             Int
  matchScore       Float
  confidence       Float    @default(0.5)
  reasons          Json
  excluded         Boolean  @default(false)
  exclusionReasons String[]

  @@unique([matchRunId, dormId])
  @@index([matchRunId])
  @@index([dormId])
  @@index([matchRunId, rank])
}

// ─── Admin Audit Log ─────────────────────────────────────────────────────────

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorEmail  String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  note        String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Rate Limit Buckets (durable, cross-instance) ────────────────────────────

model RateLimitBucket {
  id          String   @id @default(cuid())
  keyHash     String   @unique
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([keyHash])
  @@index([windowStart])
}

// ─── Data Quality ────────────────────────────────────────────────────────────

model DataQualityReport {
  id                 String   @id @default(cuid())
  collegeId          String?
  college            College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  state              String?
  totalDorms         Int      @default(0)
  missingCost        Int      @default(0)
  missingAmenities   Int      @default(0)
  missingSources     Int      @default(0)
  lowConfidenceCount Int      @default(0)
  duplicateWarnings  Int      @default(0)
  staleRecords       Int      @default(0)
  avgCompleteness    Float    @default(0)
  generatedAt        DateTime @default(now())

  @@index([collegeId])
  @@index([state])
}
