{
  "name": "dormscope",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace=@dormscope/web",
    "dev:api": "npm run dev --workspace=@dormscope/api",
    "build": "turbo run build",
    "db:generate": "npm run generate --workspace=@dormscope/database",
    "db:push": "npm run push --workspace=@dormscope/database",
    "db:migrate": "npm run migrate --workspace=@dormscope/database",
    "db:seed": "npm run seed --workspace=@dormscope/database",
    "db:studio": "npm run studio --workspace=@dormscope/database",
    "db:import-institutions": "npm run import:institutions --workspace=@dormscope/database",
    "db:seed-halls": "npm run seed:halls --workspace=@dormscope/database",
    "db:coverage": "npm run coverage --workspace=@dormscope/database",
    "scraper": "npm run start --workspace=@dormscope/scraper",
    "scraper:ingest-sample": "npm run ingest:sample --workspace=@dormscope/scraper",
    "scraper:nationwide": "npm run ingest:nationwide --workspace=@dormscope/scraper",
    "db:backfill-eligibility": "tsx packages/database/scripts/backfill-unknown-eligibility.ts",
    "test": "npm run test --workspace=@dormscope/scoring && npm run test --workspace=@dormscope/scraper",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p packages/scoring --noEmit && tsc -p packages/scraper --noEmit --pretty false || true",
    "check": "npm test && npm run lint",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
